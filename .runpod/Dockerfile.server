FROM runpod/pytorch:1.0.2-cu1281-torch280-ubuntu2404

ENV HF_HUB_ENABLE_HF_TRANSFER=0 \
    HF_HOME=/opt/marimba/huggingface \
    PYTHONUNBUFFERED=1

WORKDIR /app

# The base image's Debian cryptography installation has no pip RECORD.
RUN python -m pip install --no-cache-dir --ignore-installed cryptography

COPY pyproject.toml README.md LICENSE THIRD_PARTY_NOTICES.md ./
COPY src/ ./src/
RUN python -m pip install --no-cache-dir '.[torch,server]'

RUN python - <<'PY'
from huggingface_hub import snapshot_download
from transformers import WhisperTokenizer

from marimba._head import TEXT_REPO, TEXT_REVISION
from marimba.weights import DEFAULT_MODEL_REPO, ENCODER_REPO, ENCODER_REVISION, load_manifest

load_manifest(DEFAULT_MODEL_REPO, None)
snapshot_download(ENCODER_REPO, revision=ENCODER_REVISION)
WhisperTokenizer.from_pretrained(TEXT_REPO, revision=TEXT_REVISION)
PY

ENV HF_HUB_OFFLINE=1 \
    TRANSFORMERS_OFFLINE=1

# BLAS and OpenMP read these at import, before `--threads` can cap them.
ENV OMP_NUM_THREADS=1 \
    MKL_NUM_THREADS=1 \
    OPENBLAS_NUM_THREADS=1 \
    NUMEXPR_NUM_THREADS=1 \
    TOKENIZERS_PARALLELISM=false

# Platforms that inject only environment variables pass the PEM pair base64-encoded.
COPY --chmod=755 <<'SH' /usr/local/bin/marimba-entrypoint
#!/bin/sh
set -eu
if [ -n "${MARIMBA_TLS_CERT_B64:-}" ] && [ -n "${MARIMBA_TLS_KEY_B64:-}" ]; then
    umask 077
    mkdir -p /run/marimba
    printf %s "$MARIMBA_TLS_CERT_B64" | base64 -d > /run/marimba/tls.crt
    printf %s "$MARIMBA_TLS_KEY_B64" | base64 -d > /run/marimba/tls.key
    export MARIMBA_TLS_CERTFILE=/run/marimba/tls.crt MARIMBA_TLS_KEYFILE=/run/marimba/tls.key
    unset MARIMBA_TLS_CERT_B64 MARIMBA_TLS_KEY_B64
fi
exec "$@"
SH

# The probe cannot see how TLS was configured (flags, variables or the entrypoint), so it
# tries HTTPS first. Loopback only, hence no certificate verification.
COPY --chmod=755 <<'PY' /usr/local/bin/marimba-healthcheck
#!/usr/bin/env python
import ssl
import urllib.error
import urllib.request

try:
    urllib.request.urlopen(
        "https://127.0.0.1:8000/ping", timeout=2, context=ssl._create_unverified_context()
    )
except urllib.error.HTTPError:
    raise
except (urllib.error.URLError, OSError):
    urllib.request.urlopen("http://127.0.0.1:8000/ping", timeout=2)
PY

EXPOSE 8000
HEALTHCHECK --interval=30s --timeout=5s --start-period=120s CMD ["marimba-healthcheck"]

ENTRYPOINT ["marimba-entrypoint"]
CMD ["marimba", "serve", "--host", "0.0.0.0", "--port", "8000", "--backend", "torch", "--device", "cuda", "--model-id", "charcot-ai/marimba", "--prompt-price", "0.000002", "--completion-price", "0.000001", "--datacenters", "US", "--ready", "--threads", "1", "--keep-alive-seconds", "75"]
